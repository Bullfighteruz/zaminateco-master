# ZAMINAT.eco Backend Environment Template
NODE_ENV=development
PORT=3000

# Database (PostgreSQL / Supabase Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/zaminat_db

# Security & Auth
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRATION=7d

# Google Gemini AI Provider (Server-Side Secret)
GEMINI_API_KEY=your-gemini-api-key-here
