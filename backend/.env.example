# ZAMINAT.eco Backend Environment Template
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=https://zaminat.uz,https://www.zaminat.uz,http://localhost:5173

# Database (PostgreSQL / Supabase Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/zaminat_db

# Security & Auth
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
JWT_EXPIRATION=7d

# Server-Side AI Provider Selection (openai | gemini)
AI_PROVIDER=openai

# OpenAI Provider Configuration (Server-Side Secret)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_SCAN_MODEL=gpt-4o
OPENAI_PLANNER_MODEL=gpt-4o

# Google Gemini AI Provider Configuration (Server-Side Secret - Available for Reinstatement)
GEMINI_API_KEY=your-gemini-api-key-here
