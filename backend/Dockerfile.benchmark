# ZAMINAT AI AGENT v2 — Dedicated Benchmark Dockerfile
# Build context: backend/ directory

FROM node:20-alpine AS builder

WORKDIR /app

# Copy package descriptors
COPY package*.json ./
COPY tsconfig*.json ./

# Install dependencies including devDependencies for ts-node / typescript
RUN npm ci

# Copy backend source code and benchmark scripts
COPY src ./src
COPY scripts ./scripts

# Set production environment flag for execution
ENV NODE_ENV=production

# Entrypoint executes benchmark harness in qualification mode
CMD ["npx", "ts-node", "scripts/agent-v2-benchmark/benchmark.ts", "--mode", "qualification"]
