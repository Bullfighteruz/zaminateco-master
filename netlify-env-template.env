# Netlify Environment Variables Template
# 
# HOW TO USE:
# 1. Copy this file and rename it to: netlify-env-variables.env
# 2. Replace the placeholder values below with your actual backend URL
# 3. In Netlify dashboard:
#    - Go to: Site settings → Environment variables
#    - Click: "Add a variable" → "Import from a .env file"
#    - Select this file to import all variables
#
# ============================================
# REQUIRED VARIABLES
# ============================================

# Backend API URL
# Replace with your deployed backend URL
# Examples:
#   Railway: https://your-app.up.railway.app/api/v1
#   Render: https://your-app.onrender.com/api/v1
#   Heroku: https://your-app.herokuapp.com/api/v1
#   Custom: https://api.zaminat.eco/api/v1
VITE_API_URL=https://your-backend-url.com/api/v1

# ============================================
# OPTIONAL VARIABLES (uncomment if needed)
# ============================================

# NODE_ENV=production

